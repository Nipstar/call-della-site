# Build-time public config. Copy to .env.local for local overrides
# OR set these in Coolify build environment before `npm run build`.
# Defaults in src/lib/config.ts match production values.
#
# NEXT_PUBLIC_* prefix is required — Next.js bakes these into the
# client bundle at build time. Without the prefix the value is
# server-only (which we don't have under `output: "export"`).

# Site origin used in canonical URLs, OG tags, sitemap, robots, schema @id
NEXT_PUBLIC_SITE_URL=https://calldella.com

# Plausible analytics domain (must match the site set up in Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=calldella.com

# n8n webhook for /contact form submissions
# Test endpoint:  https://antekauto.app.n8n.cloud/webhook-test/call-della
# Production:     https://antekauto.app.n8n.cloud/webhook/call-della
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://antekauto.app.n8n.cloud/webhook-test/call-della

# Cal.com booking link (iframed by BookingModal)
NEXT_PUBLIC_CALCOM_URL=https://cal.com/antek-automation/30min-gmail

# Public-facing contact email
NEXT_PUBLIC_CONTACT_EMAIL=hello@calldella.com
